# Environment Variables for Hermoso Descanso Hotel Management System
# Copy this file to .env and update with your actual values

# Database - Use MongoDB Atlas for production
MONGODB_URI=mongodb://localhost:27017/hotel-db

# Authentication - Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random

# Email - For booking confirmations (optional)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Server - Default port
PORT=5000
